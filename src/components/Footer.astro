---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const startYear = Number(site.since.slice(0, 4));
const year = new Date().getFullYear();
const years = year > startYear ? `${startYear}–${year}` : `${startYear}`;
---

<footer class="footer">
  <p class="footer__pill glass glass--clear">
    <span data-cursor>© {years} {site.name}<span class="latin" lang="en"> {site.nameLatin}</span></span>
    <span aria-hidden="true">·</span>
    <a href={site.repo} target="_blank" rel="noopener noreferrer">原始碼</a>
    <span aria-hidden="true">·</span>
    <span data-cursor>v{__APP_VERSION__}</span>
  </p>
  <!-- 跑不動會自動換成輕量模式（scripts/perf.ts），被誤判或想省電時可以自己切換 -->
  <button class="footer__lite glass glass--clear" type="button" data-lite-toggle aria-label="輕量模式" aria-pressed="false" title="輕量模式：關">
    <Icon name="Feather" />
  </button>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }

  .footer__pill {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 13px;
  }

  .footer__pill a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* 跟版權那顆膠囊一樣高的圓形按鈕；開著的時候用強調色 */
  .footer__lite {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: inherit;
    transition:
      transform 0.45s var(--spring),
      color 0.2s var(--ease);
  }

  .footer__lite :global(svg) {
    width: 17px;
    height: 17px;
  }

  .footer__lite[aria-pressed="true"] {
    color: var(--accent);
  }

  .footer__lite:active {
    transform: scale(0.86);
    transition-duration: 0.1s;
  }

  @media (max-width: 959px) {
    .footer__pill {
      gap: 6px;
      padding: 8px 16px;
      font-size: 12px;
    }

    .latin {
      display: none;
    }
  }
</style>
