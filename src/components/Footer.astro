---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const startYear = Number(site.since.slice(0, 4));
const year = new Date().getFullYear();
const years = year > startYear ? `${startYear}–${year}` : `${startYear}`;
---

<footer class="footer">
  <p class="footer__pill glass glass--clear">
    <span data-cursor>© {years} {site.name}<span class="latin" lang="en"> {site.nameLatin}</span></span>
    <span aria-hidden="true">·</span>
    <a href={site.repo} target="_blank" rel="noopener noreferrer">原始碼</a>
    <span aria-hidden="true">·</span>
    <span data-cursor>v{__APP_VERSION__}</span>
    <span class="footer__icp-sep" aria-hidden="true">·</span>
    <a class="footer__icp" href={`https://icp.gov.moe/?keyword=${site.moeIcp}`} target="_blank" rel="noopener noreferrer">萌ICP备{site.moeIcp}号</a>
  </p>
  <div class="footer__btns">
    <a class="footer__round glass glass--clear" href={site.coffee} target="_blank" rel="noopener noreferrer" aria-label="請我喝杯咖啡" title="請我喝杯咖啡">
      <Icon name="Coffee" />
    </a>
    <!-- 跑不動會自動換成輕量模式（scripts/perf.ts），被誤判或想省電時可以自己切換 -->
    <button class="footer__round glass glass--clear" type="button" data-lite-toggle aria-label="輕量模式" aria-pressed="false" title="輕量模式：關">
      <Icon name="Feather" />
    </button>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: auto;
  }

  .footer__pill {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    gap: 8px;
    min-height: 38px; /* 跟圓鈕一樣高 */
    margin: 0;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 13px;
  }

  .footer__pill a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__btns {
    display: flex;
    gap: inherit;
  }

  /* 跟版權那顆膠囊一樣高的圓形按鈕（咖啡、輕量模式）；輕量模式開著的時候用強調色 */
  .footer__round {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    color: inherit;
    transition:
      transform 0.45s var(--spring),
      color 0.2s var(--ease);
  }

  .footer__round :global(svg) {
    width: 17px;
    height: 17px;
  }

  .footer__round[aria-pressed="true"] {
    color: var(--accent);
  }

  .footer__round:active {
    transform: scale(0.86);
    transition-duration: 0.1s;
  }

  @media (max-width: 959px) {
    /* 間距收一點，360px 寬的手機才排得下兩顆圓鈕 */
    .footer {
      gap: 6px;
    }

    .footer__pill {
      gap: 6px;
      padding: 8px 12px;
      font-size: 12px;
    }

    .latin {
      display: none;
    }
  }

  /* 一行塞不下時：備案號自己一行（前面的點拿掉），圓鈕改上下疊，膠囊拉到跟兩顆圓鈕一樣高
     ponytail: 斷點是量出來的（一行約要 450px 加左右留白），字型差很多才需要重量 */
  @media (max-width: 500px) {
    .footer {
      align-items: stretch;
    }

    .footer__btns {
      flex-direction: column;
    }

    .footer__icp-sep {
      display: none;
    }

    .footer__icp {
      flex-basis: 100%;
      text-align: center;
    }
  }
</style>
