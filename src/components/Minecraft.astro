---
import { siDiscord } from "simple-icons";
import logo from "../assets/lunworld-logo.svg";
import { minecraft } from "../config/minecraft";
import BrandIcon from "./BrandIcon.astro";
import CopyButton from "./CopyButton.astro";
import Icon from "./Icon.astro";
---

<section class="panel glass rise" data-refract aria-labelledby="mc-title">
  <h2 id="mc-title" class="panel-title"><Icon name="Pickaxe" />我在經營的 Minecraft 伺服器</h2>
  <div class="mc">
    <div class="mc__info">
      <span class="mc__logo" data-cursor>
        <img src={logo.src} width="64" height="64" alt={`${minecraft.name} 的 Logo`} decoding="async" />
      </span>
      <div class="mc__text">
        <p class="mc__name"><strong lang="en">{minecraft.name}</strong><span>{minecraft.nameZh}</span></p>
        <p class="mc__desc">{minecraft.description}</p>
        <ul class="mc__facts" aria-label="伺服器資訊">
          {minecraft.facts.map((fact) => <li class="pill" data-cursor>{fact}</li>)}
        </ul>
      </div>
    </div>

    <div class="mc__actions">
      <div class="mc__address tile">
        <span class="mc__address-text">
          <span>伺服器位址</span>
          <strong>{minecraft.address}</strong>
        </span>
        <CopyButton text={minecraft.address} label="伺服器位址" />
      </div>
      <a class="mc__discord" href={minecraft.discord} target="_blank" rel="noopener noreferrer">
        <BrandIcon path={siDiscord.path} />
        加入 Discord 群
      </a>
      <div class="mc__links">
        <a class="tile" href={minecraft.website} target="_blank" rel="noopener noreferrer">官網 <Icon name="ArrowUpRight" /></a>
        <a class="tile" href={minecraft.forum} target="_blank" rel="noopener noreferrer">巴哈介紹文 <Icon name="ArrowUpRight" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    --delay: 180ms;
  }

  .mc {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 20px;
  }

  .mc__info {
    display: flex;
    flex: 999 1 300px;
    align-items: flex-start;
    gap: 16px;
    min-width: 0;
  }

  /* Logo 是很淡的粉藍色，墊一個白色圓底才看得清楚 */
  .mc__logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    box-shadow:
      0 0 0 1px var(--edge-dim),
      0 6px 18px rgb(20 40 80 / 0.12);
    transition: transform 0.6s var(--spring);
  }

  /* 跟頭像一樣，滑過去會歪一下頭 */
  .mc__logo:hover {
    transform: rotate(-6deg) scale(1.04);
  }

  .mc__logo img {
    width: 52px;
    height: 52px;
  }

  .mc__text {
    min-width: 0;
  }

  .mc__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0;
    line-height: 1.25;
  }

  .mc__name strong {
    font-size: 22px;
    font-weight: 900;
  }

  .mc__name span {
    color: var(--text-2);
    font-size: 14px;
    font-weight: 700;
  }

  .mc__desc {
    margin: 8px 0 0;
    color: var(--text-2);
    font-size: 14px;
  }

  .mc__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .mc__actions {
    display: flex;
    flex: 1 1 250px;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .mc__address {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 6px 6px 16px;
    border-radius: 18px;
  }

  .mc__address-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .mc__address-text span {
    color: var(--text-2);
    font-size: 12px;
  }

  .mc__address-text strong {
    overflow: hidden;
    font-size: 15px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mc__discord {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 15px;
    font-weight: 700;
    transition: transform 0.45s var(--spring);
  }

  .mc__discord:hover {
    transform: translateY(-2px);
  }

  .mc__discord:active {
    transform: scale(0.97);
    transition-duration: 0.12s;
  }

  .mc__discord :global(svg) {
    width: 18px;
    height: 18px;
  }

  .mc__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .mc__links a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
  }

  .mc__links :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 479px) {
    .mc__logo {
      width: 52px;
      height: 52px;
    }

    .mc__logo img {
      width: 42px;
      height: 42px;
    }
  }
</style>
