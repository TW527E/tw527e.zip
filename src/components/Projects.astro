---
import { projects } from "../config/projects";
import { socialLinks } from "../config/links";
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

const github = socialLinks.find((l) => l.name === "GitHub")?.url ?? "https://github.com/";
---

<section class="panel projects glass rise" data-refract aria-labelledby="projects-title">
  <div class="projects__head">
    <h2 id="projects-title" class="panel-title"><Icon name="Sparkles" />做過的東西</h2>
    <a class="projects__all" href={`${github}?tab=repositories`} target="_blank" rel="noopener noreferrer">
      <span class="long">去 GitHub 看全部</span><span class="short">看全部</span>
      <Icon name="ArrowUpRight" />
    </a>
  </div>

  <ul class="projects__list">
    {
      projects.map((p) => (
        <li>
          <a class="tile" href={p.url} target="_blank" rel="noopener noreferrer">
            <span class="projects__title">
              {/* 沒有 Logo 的用同樣大小的淡色圖示，排起來才整齊 */}
              <span class:list={["projects__logo", { "is-fill": p.logoFill, "is-icon": !p.logo }]}>
                {p.logo ? <Image src={p.logo} alt="" width={80} height={80} /> : <Icon name={p.icon ?? "Code"} />}
              </span>
              <strong>{p.name}</strong>
            </span>
            <span class="projects__desc">{p.description}</span>
            <span class="projects__meta">
              <span class="pill">{p.language}</span>
              {p.badge && <span class="projects__badge">{p.badge}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="projects__hint" aria-hidden="true">左右滑動看更多</p>
</section>

<style>
  .panel {
    --delay: 220ms;
  }

  .projects__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .projects__head .panel-title {
    margin: 0;
  }

  /* 44px 的點擊範圍，但不撐高標題列 */
  .projects__all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    margin: -12px 0;
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }

  .projects__all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .projects__all :global(svg) {
    width: 16px;
    height: 16px;
  }

  .projects__all .short,
  .projects__hint {
    display: none;
  }

  .projects__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
  }

  .projects__list a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 16px 18px;
    border-radius: 20px;
  }

  .projects__title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 2px;
  }

  .projects__list strong {
    min-width: 0;
    font-size: 15px;
    line-height: 1.35;
  }

  .projects__logo {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    overflow: hidden;
    border-radius: 12px;
  }

  .projects__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* 滿版的方形 Logo：裁成圓角方塊 */
  .projects__logo.is-fill :global(img) {
    object-fit: cover;
  }

  /* 沒有 Logo：只畫一圈淡淡的框和圖示，不要搶戲 */
  .projects__logo.is-icon {
    box-shadow: inset 0 0 0 1px var(--track);
    color: var(--text-2);
  }

  .projects__logo.is-icon :global(svg) {
    width: 20px;
    height: 20px;
    opacity: 0.8;
  }

  .projects__desc {
    flex: 1;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .projects__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .projects__badge {
    padding: 1px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
  }

  /* 手機：改成左右滑動的一排 */
  @media (max-width: 639px) {
    .projects {
      padding-inline: 0;
      overflow: hidden;
    }

    .projects__head {
      margin-bottom: 14px;
      padding-inline: 20px;
    }

    .projects__all .long {
      display: none;
    }

    .projects__all .short {
      display: inline;
    }

    .projects__list {
      display: flex;
      gap: 10px;
      padding: 0 20px 2px;
      overflow-x: auto;
      scroll-padding: 0 20px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .projects__list::-webkit-scrollbar {
      display: none;
    }

    .projects__list li {
      flex: 0 0 236px;
      scroll-snap-align: start;
    }

    .projects__list a {
      padding: 16px;
    }

    .projects__list a:hover {
      transform: none;
    }

    .projects__hint {
      display: block;
      margin: 10px 20px 0;
      color: var(--text-2);
      font-size: 12px;
    }
  }
</style>
