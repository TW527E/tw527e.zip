---
import "../styles/global.css";
import { site } from "../config/site";

interface Props {
  title?: string;
  description?: string;
  /** 不想被搜尋引擎收錄的頁面（例如 404）設成 true */
  noindex?: boolean;
  /** 結構化資料（schema.org），讓搜尋引擎和 AI 知道這頁在講誰 */
  jsonLd?: object;
}

const { title = `${site.title} · ${site.handle}`, description = site.description, noindex = false, jsonLd } = Astro.props;
// JSON 裡的 < 要跳脫，不然內容有 </script> 就會把標籤提早關掉
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/og.jpg", site.url).href;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${site.name} ${site.nameLatin}`} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#dfe7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11131b" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/pacifico-subset.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} 的個人主頁`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${site.handle}`} />

    {/* 不會執行的資料區塊，CSP 不會擋 */}
    {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}

    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
