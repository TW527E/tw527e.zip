// Cloudflare Workers 的設定。部署：在 Cloudflare 後台連 GitHub，或在本機 `pnpm build && npx wrangler deploy`。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tw527e-zip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // astro build 的輸出；_headers 一樣會套用
    "directory": "./dist",
    "binding": "ASSETS",
    // 找不到的網址回 404.html
    "not_found_handling": "404-page",
    // 只有留言 API 會跑 Worker，其他都是靜態檔案
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // 沒寫 database_id：第一次部署時 wrangler 會自動建一個叫 tw527e-zip-db 的資料庫
      "binding": "DB"
    }
  ],
  "observability": {
    "enabled": true
  }
}
